// Auto-generated grammar for MF6 GWT-IST -- see typed.lark's own
// header note for why newlines are significant here.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore COMMA

start: _NL* (block _NL*)*
block: options_block | griddata_block

options_block: "begin"i "options"i _NL _NL* options_fields _NL* "end"i "options"i
griddata_block: "begin"i "griddata"i _NL _NL* griddata_fields _NL* "end"i "griddata"i
options_fields: ((save_flows | budget_filerecord | budgetcsv_filerecord | sorption | first_order_decay | zero_order_decay | cim_filerecord | cimprintrecord | sorbate_filerecord | export_array_ascii | export_array_netcdf | open_close_redirect) _NL*)*
griddata_fields: ((porosity | volfrac | zetaim | cim | decay | decay_sorbed | bulk_density | distcoef | sp2 | open_close_redirect) _NL*)*
save_flows: "save_flows"i  _NL
budget_filerecord: "budget"i "fileout"i word _NL
budgetcsv_filerecord: "budgetcsv"i "fileout"i word _NL
sorption: "sorption"i (sorption_linear | sorption_freundlich | sorption_langmuir) _NL

sorption_linear: "linear"i
sorption_freundlich: "freundlich"i
sorption_langmuir: "langmuir"i

first_order_decay: "first_order_decay"i  _NL
zero_order_decay: "zero_order_decay"i  _NL
cim_filerecord: "cim"i "fileout"i word _NL
cimprintrecord: "cim"i "print_format"i formatrecord _NL
sorbate_filerecord: "sorbate"i "fileout"i word _NL
export_array_ascii: "export_array_ascii"i  _NL
export_array_netcdf: "export_array_netcdf"i  _NL
porosity: "porosity"i [_NL] array
volfrac: "volfrac"i [_NL] array
zetaim: "zetaim"i [_NL] array
cim: "cim"i [_NL] array
decay: "decay"i [_NL] array
decay_sorbed: "decay_sorbed"i [_NL] array
bulk_density: "bulk_density"i [_NL] array
distcoef: "distcoef"i [_NL] array
sp2: "sp2"i [_NL] array
formatrecord: ["columns"i integer] ["width"i integer] ["digits"i integer] word
