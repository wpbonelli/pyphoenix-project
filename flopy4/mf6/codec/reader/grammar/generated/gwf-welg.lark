// Auto-generated grammar for MF6 GWF-WELG -- see typed.lark's own
// header note for why newlines are significant here.
%import typed.integer -> integer
%import typed.double -> double
%import typed.number -> number
%import typed.string -> string
%import typed.word -> word
%import typed.array -> array
%import typed.record -> record
%import typed.open_close_redirect -> open_close_redirect
%import typed._NL -> _NL
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore COMMA

start: _NL* (block _NL*)*
block: options_block | dimensions_block | period_block

options_block: "begin"i "options"i _NL _NL* options_fields _NL* "end"i "options"i
dimensions_block: "begin"i "dimensions"i _NL _NL* dimensions_fields _NL* "end"i "dimensions"i
period_block: "begin"i "period"i block_index _NL _NL* period_fields _NL* "end"i "period"i [block_index]
block_index: number
options_fields: ((readarraygrid | auxiliary | auxmultname | print_input | print_flows | save_flows | auto_flow_reduce | afrcsv_filerecord | flow_reduction_length | obs_filerecord | mover | export_array_netcdf | open_close_redirect) _NL*)*
dimensions_fields: ((open_close_redirect) _NL*)*
period_fields: ((q | aux | open_close_redirect) _NL*)*
readarraygrid: "readarraygrid"i  _NL
auxiliary: "auxiliary"i word+ _NL
auxmultname: "auxmultname"i string
print_input: "print_input"i  _NL
print_flows: "print_flows"i  _NL
save_flows: "save_flows"i  _NL
auto_flow_reduce: "auto_flow_reduce"i double _NL
afrcsv_filerecord: "auto_flow_reduce_csv"i "fileout"i word _NL
flow_reduction_length: "flow_reduction_length"i  _NL
obs_filerecord: "obs6"i "filein"i word _NL
mover: "mover"i  _NL
export_array_netcdf: "export_array_netcdf"i  _NL
q: "q"i [_NL] array
aux: word [_NL] array
