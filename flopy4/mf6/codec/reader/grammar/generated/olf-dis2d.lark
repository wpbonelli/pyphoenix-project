griddata_fields: ((delr | delc | bottom | idomain | open_close_redirect) _NL*)*
length_units: "length_units"i string
nogrb: "nogrb"i  _NL
grb_filerecord: "grb6"i "fileout"i word _NL
xorigin: "xorigin"i double _NL
yorigin: "yorigin"i double _NL
angrot: "angrot"i double _NL
export_array_ascii: "export_array_ascii"i  _NL
crs: "crs"i string
nrow: "nrow"i integer _NL
ncol: "ncol"i integer _NL
delr: "delr"i [_NL] array
delc: "delc"i [_NL] array
