%import typed._END -> _END
%import typed.COMMA -> COMMA
%import common.WS_INLINE
%import common.SH_COMMENT
%import typed.BANG_COMMENT -> BANG_COMMENT

%ignore WS_INLINE
%ignore SH_COMMENT
%ignore BANG_COMMENT
%ignore COMMA

start: [_NL] (block [_NL])*
block: options__block | period__block | unknown_block

options__block: _BEGIN "options"i [_remark] _NL options__fields _END "options"i
period__block: _BEGIN "period"i block_index [_remark] _NL period__fields _END "period"i [block_index]
%import typed.block_index -> block_index
options__fields: (budget_file__rec | budgetcsv_file__rec | concentration_file__rec | concentrationprint__rec | open_close_redirect _NL | unknown_line)*
period__fields: (stress_period_data__saverecord__rec__elem | stress_period_data__printrecord__rec__elem | open_close_redirect _NL | unknown_line)*
budget_file__rec: "budget"i budget_filerecord__budgetfile__val [_remark] _NL
budget_filerecord__budgetfile__val: "fileout"i word
budgetcsv_file__rec: "budgetcsv"i budgetcsv_filerecord__budgetcsvfile__val [_remark] _NL
budgetcsv_filerecord__budgetcsvfile__val: "fileout"i word
concentration_file__rec: "concentration"i concentration_filerecord__concentrationfile__val [_remark] _NL
concentration_filerecord__concentrationfile__val: "fileout"i word
concentrationprint__rec: "concentration"i "print_format"i formatrecord__rec [_remark] _NL
stress_period_data__saverecord__rec__elem: "save"i saverecord__rtype__val ocsetting__union [_remark] _NL
saverecord__rtype__val: word
stress_period_data__printrecord__rec__elem: "print"i printrecord__rtype__val ocsetting__union [_remark] _NL
printrecord__rtype__val: word
formatrecord__rec: [formatrecord__columns__val] [formatrecord__width__val] [formatrecord__digits__val] formatrecord__format__val
formatrecord__columns__val: "columns"i integer
formatrecord__width__val: "width"i integer
formatrecord__digits__val: "digits"i integer
formatrecord__format__val: word
ocsetting__union: ocsetting__all__kw | ocsetting__first__kw | ocsetting__last__kw | ocsetting__frequency__val | ocsetting__steps__val

!ocsetting__all__kw: "all"i
!ocsetting__first__kw: "first"i
!ocsetting__last__kw: "last"i
ocsetting__frequency__val: "frequency"i integer
ocsetting__steps__val: "steps"i integer+
