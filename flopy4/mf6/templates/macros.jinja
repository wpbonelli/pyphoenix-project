{% macro field(f) %}
{% set type = f|field_type %}
{% if type in ['keyword', 'integer', 'double precision', 'string'] %}
{{ scalar(f) }}
{% elif type == 'record' %}
{{ record(f) }}
{% elif type == 'keystring' %}
{{ keystring(f) }}
{% elif type == 'recarray' %}
{{ recarray(f, how=f|array_how) }}
{% endif %}
{% endmacro %}

{% macro scalar(f) %}
{% set type = f|field_type %}
{% set value = f|field_value %}
{% if value is not none %}{{ f.name.upper() }}{% if type != 'keyword' %} {{ value }}{% endif %}{% endif %}
{% endmacro %}

{% macro keystring(f) %}
{% for item in f.children.values() -%}
{{ field(item) }}
{%- endfor %}
{% endmacro %}

{% macro record(f) %}
{% for item in f.children.values() -%}
{% if item.tagged %}{{ item.name.upper() }} {% endif %}{{ field(item) }}
{%- endfor %}
{% endmacro %}

{% macro recarray(f, how="internal") %}
{% set name = f.name %}
{% set value = f|field_value %}
{{ name.upper() }}{% if "layered" in how %} LAYERED{% endif %}

{% if how == "constant" %}
CONSTANT {{ value.item() }}
{% elif how == "layered constant" %}
{% for layer in value -%}
CONSTANT {{ layer.item() }}
{%- endfor %}
{% elif how == "internal" %}
INTERNAL
{% for chunk in value|array_chunks -%}
{{ chunk|array2string }}
{%- endfor %}
{% elif how == "external" %}
OPEN/CLOSE {{ value }}
{% endif %}
{% endmacro %}

{% macro list(block_name, block, single=False) %}
{#
Use lazy conversion to avoid pre-computing all period data.
The to_period_records filter handles component-specific logic
and only converts arrays when the template actually needs them.
#}
{# DEBUG: print info about the macro call #}
{{ "DEBUG: macros.list called with block_name=" ~ block_name ~ ", single=" ~ single }}
{% set d = (block_name, block)|to_period_records %}
{{ "DEBUG: to_period_records returned " ~ d|length ~ " items" }}
{% if single %}
BEGIN {{ block_name.upper() }}
{% for line in d.values() %}
{{ line|join(" ")|upper }}
{% endfor %}
END {{ block_name.upper() }}
{% else %}
{% for kper, value in d.items() %}
BEGIN {{ block_name.upper() }} {{ kper + 1 }}
{% for line in value %}
{{ line|join(" ")|upper }}
{% endfor %}
END {{ block_name.upper() }} {{ kper + 1 }}

{% endfor %}
{% endif %}
{% endmacro %}
